# Mangadvisor: deterministic checkout line endings on Windows and Linux.
# Git always stores LF; the Windows command files get native CRLF locally.
# Explicit policies override a developer's global core.autocrlf setting.
* text=auto

# Windows native launchers / Windows PowerShell 5.1 (ASCII-safe scripts)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Linux containers and portable source/documentation
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.env.example text eol=lf

# Models, documents and binary assets must never be converted.
*.docx binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
