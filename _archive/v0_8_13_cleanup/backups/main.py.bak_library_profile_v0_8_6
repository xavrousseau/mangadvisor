        params["q"] = f"%{q}%"

    where_clause = " AND ".join(filters)

    sql = f"""
        SELECT
            l.id,
            l.user_id,
            l.manga_id,
            l.library_status,
            l.user_score::float AS user_score,
            l.is_favorite,
