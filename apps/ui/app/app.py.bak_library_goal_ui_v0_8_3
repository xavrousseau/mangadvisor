def format_list(values: list[str] | None, empty_label: str = "Non renseigné") -> str:
    if not values:
        return empty_label

    return ", ".join(values)


def format_number(value: Any, decimals: int = 1) -> str:
    if value is None:
        return "N/A"

    try:
        return f"{float(value):.{decimals}f}"
    except (TypeError, ValueError):
        return str(value)


def format_integer(value: Any) -> str:
    if value is None:
        return "N/A"

    try:
        return f"{int(value):,}".replace(",", " ")
    except (TypeError, ValueError):
        return str(value)


def proximity_label(score: Any) -> str:
    if score is None:
        return "N/A"

    try:
        value = float(score)
    except (TypeError, ValueError):
        return "N/A"

    if value >= 100:
        return "Très forte"
    if value >= 80:
        return "Forte"
    if value >= 60:
        return "Moyenne"
    return "Faible"


def display_badges(label: str, values: list[str] | None) -> None:
    st.write(f"**{label} :**")

    if not values:
        st.caption("Non renseigné")
        return

    badges = " ".join([f"`{value}`" for value in values])
    st.markdown(badges)


def display_manga_detail(manga: dict[str, Any]) -> None:
    """
    Affiche une fiche manga complète.
    """
    title = manga.get("title") or "Titre inconnu"
    title_english = manga.get("title_english")
    title_japanese = manga.get("title_japanese")
    synopsis = manga.get("synopsis")

    st.markdown(f"## {title}")

    subtitle_parts = []

    if title_english and title_english != title:
        subtitle_parts.append(f"**Titre anglais :** {title_english}")

    if title_japanese:
        subtitle_parts.append(f"**Titre japonais :** {title_japanese}")

    if subtitle_parts:
        st.markdown(" · ".join(subtitle_parts))

    col1, col2, col3, col4 = st.columns(4)

    with col1:
        st.metric("Score", format_number(manga.get("score"), 2))

    with col2:
        st.metric("Statut", manga.get("status") or "N/A")

    with col3:
        st.metric("Type", manga.get("manga_type") or "N/A")

    with col4:
        st.metric("Popularité", manga.get("popularity") or "N/A")

    col5, col6, col7, col8 = st.columns(4)

    with col5:
        st.metric("Volumes", manga.get("volumes") or "N/A")

    with col6:
        st.metric("Chapitres", manga.get("chapters") or "N/A")

    with col7:
        st.metric("Membres", format_integer(manga.get("members")))

    with col8:
        st.metric("Favoris", format_integer(manga.get("favorites")))

    st.divider()

    c1, c2, c3 = st.columns(3)

    with c1:
        display_badges("Genres", manga.get("genres"))

    with c2:
        display_badges("Thèmes", manga.get("themes"))

    with c3:
        display_badges("Cible éditoriale", manga.get("demographics"))

    st.divider()

    st.write("**Synopsis :**")

    if synopsis:
        st.write(synopsis)
    else:
        st.caption("Aucun synopsis disponible pour ce manga.")


def display_recommendation_card(
    recommendation: dict[str, Any],
    index: int,
) -> None:
    """
    Affiche une carte de recommandation.
    """
    with st.container(border=True):
        st.markdown(f"### {index}. {recommendation.get('title')}")

        c1, c2, c3, c4 = st.columns(4)

        with c1:
            st.metric(
                "Score reco",
                format_number(recommendation.get("recommendation_score"), 1),
            )

        with c2:
            st.metric(
                "Proximité calculée",
                proximity_label(recommendation.get("recommendation_score")),
            )

        with c3:
            st.metric(
                "Score manga",
                format_number(recommendation.get("score"), 2),
            )

        with c4:
            st.metric(
                "Statut",
                recommendation.get("status") or "N/A",
            )

        community_from = recommendation.get("community_recommended_from") or []
        community_votes = recommendation.get("community_votes") or 0
        community_score = recommendation.get("community_score") or 0

        if community_from:
            st.write("**Signal communautaire :**")
            st.write(
                "Recommandé depuis "
                + format_list(community_from)
                + f" — {community_votes} votes communautaires "
                + f"(bonus {format_number(community_score, 1)})"
            )

        st.write("**Cible éditoriale commune :**")
        st.write(
            format_list(
                recommendation.get("common_demographics"),
                "Aucune cible commune renseignée",
            )
        )

        st.write("**Thèmes communs :**")
        st.write(
            format_list(
                recommendation.get("common_themes"),
                "Aucun thème commun renseigné",
            )
        )

        st.write("**Genres communs :**")
        st.write(
            format_list(
                recommendation.get("common_genres"),
                "Aucun genre commun renseigné",
            )
        )

        sensitive_mismatches = recommendation.get("sensitive_mismatches") or []

        if sensitive_mismatches:
            st.warning(
                "Éléments qui peuvent éloigner la recommandation : "
                + ", ".join(sensitive_mismatches)
            )

        st.info(recommendation.get("reason", "Pas d'explication disponible."))

        manga_id = recommendation.get("id")

        if manga_id:
            with st.expander("Voir la fiche manga"):
                manga_detail = get_manga_detail(int(manga_id))
                display_manga_detail(manga_detail)


